{
  "name": "parkeroslo",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "expo-router/entry",
  "type": "module",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.24",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.21",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "undici": "^8.12.4"
  },
  "scripts": {
    "prestart": "npm run design:build",
    "start": "expo start",
    "preandroid": "npm run design:build",
    "android": "expo start --android",
    "preios": "npm run design:build",
    "ios": "expo start --ios",
    "preweb": "npm run design:build",
    "web": "expo start --web",
    "start:tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "pretest": "npm run design:build",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:refresh": "node --import tsx scripts/update-data.ts && npm run design:build",
    "data:quick": "node --import tsx scripts/update-data.ts --quick && npm run design:build",
    "check": "npm run design:build && npm run typecheck && npm run lint && npm test",
    "design:build": "node --import tsx scripts/build-design.ts"
  },
  "private": true
}
