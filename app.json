{
  "expo": {
    "name": "ParkSmart",
    "slug": "parker-oslo",
    "scheme": "parkeroslo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkeroslo.mvp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#043b52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.parkeroslo.mvp",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Parker Oslo bruker posisjonen din for å vise parkering i nærheten.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Velg et skiltbilde for forhåndsvisning.",
          "cameraPermission": "Ta bilde av et skilt.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
